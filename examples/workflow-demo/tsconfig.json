{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["bun"]
	},
	"include": ["build.ts", "dev.ts", "src/**/*.ts", "src/**/*.tsx"]
}
