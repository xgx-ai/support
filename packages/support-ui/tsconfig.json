{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"strict": true,
		"noEmit": true,
		"types": ["bun"],
		"skipLibCheck": true,
		"esModuleInterop": true,
		"outDir": "dist"
	},
	"include": ["src"],
	"exclude": ["src/**/*.legacy.tsx", "src/legacy.ts"]
}
