# The deterministic local harness is the safe default.
SUPPORT_AGENT_HARNESS=mock

# For real local Codex turns, change the harness above to codex and set the key.
# OPENAI_API_KEY=

# Optional local overrides.
# SUPPORT_AGENT_CODEX_BIN=
# SUPPORT_AGENT_PORT=4185
# Optional containment root for stage-specific read-only repository context.
# The standalone harness does not need it. Full Codex dev auto-detects Support's
# parent directory so investigation can inspect explicitly mapped sibling repos.
# This is not the future writable code/testing sandbox.
# SUPPORT_AGENT_WORKSPACE_ROOT=/absolute/path/to/GitHub
